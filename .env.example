# Copy to .env.local and fill in. Everything is optional — the app runs with
# no keys (browser-stored library, no search). Add keys to unlock each feature.

# ---- Movies & Series: TMDB (free) -------------------------------------------
# Needed for searching films/series, posters, trailers, "where to watch", recs.
# Get a key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# …or use a v4 Read Access Token instead of the key:
# TMDB_ACCESS_TOKEN=
# Region for "where to watch" provider icons (default US):
TMDB_WATCH_REGION=US

# ---- Books: Google Books (optional) -----------------------------------------
# Works without a key (rate-limited). Add one for higher limits.
GOOGLE_BOOKS_API_KEY=

# ---- Recommendations: OpenAI OR a free OpenAI-compatible provider -----------
# Powers semantic "Similar titles" (Engine B) + taste-profile embeddings
# (Engine A). Optional — without it, recs still work via TMDB related lists +
# metadata scoring; this just adds semantic similarity and natural reasons.
OPENAI_API_KEY=
# Optional model overrides:
# WTW_EMBED_SMALL=text-embedding-3-small
# WTW_EMBED_LARGE=text-embedding-3-large
# WTW_RERANK_MODEL=gpt-4o-mini
#
# FREE alternative — Google Gemini (free tier does embeddings + chat).
# Get a key at https://aistudio.google.com/apikey , then set:
#   OPENAI_API_KEY=<your Gemini key>
#   WTW_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   WTW_EMBED_SMALL=gemini-embedding-001
#   WTW_EMBED_LARGE=gemini-embedding-001
#   WTW_RERANK_MODEL=gemini-2.5-flash
# (Other OpenAI-compatible hosts like Groq/OpenRouter work the same way via
#  WTW_AI_BASE_URL. Groq is free + fast but has no embeddings.)

# ---- Cloud sync: Supabase (optional) ----------------------------------------
# Without these, your library lives in this browser. Add them (and run
# supabase/migrations/0001_init.sql) to sync across devices via magic-link sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
